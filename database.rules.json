{
  "rules": {
    ".read": false,
    ".write": false,

    "liveGame": {
      ".read": true,

      "activeQuizId": {
        ".write": true,
        ".validate": "newData.isString() && newData.val().length <= 200"
      },

      "gameState": {
        ".write": true,
        "quizStatus": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "currentRoundId": { ".validate": "newData.isString() && newData.val().length <= 200" },
        "currentQuestionId": { ".validate": "newData.isString() && newData.val().length <= 200" },
        "timerDeadline": { ".validate": "newData.isNumber()" },
        "timerDuration": { ".validate": "newData.isNumber()" },
        "timerPausedRemaining": { ".validate": "newData.isNumber()" },
        "showLeaderboard": { ".validate": "newData.isBoolean()" },
        "questionStartedAt": { ".validate": "newData.isNumber()" },
        "scoredQuestionId": { ".validate": "newData.isString() && newData.val().length <= 200" }
      },

      "players": {
        "$name": {
          ".write": true,
          ".validate": "$name.length <= 40 && newData.hasChild('score')",
          "score": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000" },
          "avatar": { ".validate": "newData.isString() && newData.val().length <= 200" },
          "answer": { ".validate": "newData.isString() ? newData.val().length <= 1000 : true" },
          "answeredAt": { ".validate": "newData.isNumber()" },
          "streak": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000" },
          "bestStreak": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000" },
          "history": {
            "$qid": {
              "gain": { ".validate": "newData.isNumber()" },
              "ok": { ".validate": "newData.isNumber()" },
              "ms": { ".validate": "newData.isNumber()" }
            }
          }
        }
      },

      "reactions": {
        ".write": true,
        "$rid": {
          ".validate": "newData.hasChildren(['emoji', 'name', 't'])",
          "emoji": { ".validate": "newData.isString() && newData.val().length <= 8" },
          "name": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "t": { ".validate": "newData.isNumber()" }
        }
      },

      "poll": {
        ".write": true,
        "$name": { ".validate": "newData.isString() && newData.val().length <= 40" }
      },

      "lobbyAnswers": {
        ".write": true,
        "$name": { ".validate": "newData.isString() && newData.val().length <= 300" }
      }
    },

    "quizzes": {
      ".read": true,
      ".write": true,
      "$quizId": {
        ".validate": "newData.hasChild('title')",
        "title": { ".validate": "newData.isString() && newData.val().length <= 200" },
        "theme": { ".validate": "newData.isString() && newData.val().length <= 60" }
      }
    },

    "questionBank": {
      ".read": true,
      ".write": true
    },

    "roundBank": {
      ".read": true,
      ".write": true
    }
  }
}
